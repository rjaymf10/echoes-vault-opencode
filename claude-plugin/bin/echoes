#!/usr/bin/env bash
# Run the bundled EchoesVault launcher as the Claude Code adapter. The launcher bootstraps or
# upgrades only for explicit lifecycle commands and delegates normal operations to the
# project-local runtime.
set -euo pipefail

root="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
runtime="$root/scripts/echoes_vault.py"
version="$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$root/.claude-plugin/plugin.json" | head -n 1)"

# Windows ships a python3 Store alias that exists but cannot run, so probe instead of trusting PATH.
runs_python() {
  "$@" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1
}

python=()
if [ -n "${ECHOES_VAULT_PYTHON:-}" ]; then
  if ! runs_python "$ECHOES_VAULT_PYTHON"; then
    echo "EchoesVault: ECHOES_VAULT_PYTHON=$ECHOES_VAULT_PYTHON cannot run Python >= 3.9." >&2
    exit 127
  fi
  python=("$ECHOES_VAULT_PYTHON")
else
  for candidate in "python3" "python" "py -3"; do
    read -r -a command <<<"$candidate"
    if runs_python "${command[@]}"; then
      python=("${command[@]}")
      break
    fi
  done
  if [ "${#python[@]}" -eq 0 ]; then
    echo "EchoesVault: Python >= 3.9 not found (tried python3, python, py -3). Set ECHOES_VAULT_PYTHON." >&2
    exit 127
  fi
fi

export PYTHONUTF8=1
exec "${python[@]}" "$runtime" --agent claude --adapter-version "${version:-0.0.0}" "$@"
